---
import Reveal from '../islands/Reveal';
import { posts } from '../../data/site';
---
<section id="blog" class="section bg-aurora grain">
  <div class="orb sand" style="width:26rem;height:26rem;left:-8rem;top:-4rem"></div>
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <Reveal client:visible><p class="eyebrow">From our blog</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">Skin advice from <b>our dermatologists</b></h2></Reveal>
      </div>
      <Reveal client:visible><a href="/blog" class="btn btn-line">All articles</a></Reveal>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {posts.map((p, i) => (
        <Reveal client:visible delay={i * 0.1}>
          <a href={p.href} class="group block">
            <div class="plate">
              <div class="sq shadow-[0_30px_50px_-30px_rgba(10,34,57,.6)]">
                <img src={p.img} alt="" loading="lazy" referrerpolicy="no-referrer" class="group-hover:scale-110" />
                <span class="absolute left-3 top-3 rounded-[4px] bg-white/90 px-3 py-1 font-display text-[0.7rem] font-medium uppercase tracking-[0.14em] text-ink">{p.date}</span>
              </div>
            </div>
            <h3 class="mt-9 font-display text-[1.2rem] font-medium leading-snug transition-colors group-hover:text-sapphire">{p.title}</h3>
            <span class="btn btn-dark-ghost btn-sm mt-5 group-hover:bg-ink group-hover:text-white">Read article</span>
          </a>
        </Reveal>
      ))}
    </div>
  </div>
</section>
