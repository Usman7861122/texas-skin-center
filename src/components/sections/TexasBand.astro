---
import Reveal from '../islands/Reveal';
import { media, BOOK_URL } from '../../data/site';
---
<section class="relative isolate flex min-h-[78vh] items-center overflow-hidden text-white" aria-label="Proudly Texan">
  <img src={media.texas} alt="Downtown Houston skyline at sunset" class="kenburns absolute inset-0 -z-20 h-full w-full object-cover" loading="lazy" referrerpolicy="no-referrer" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/90 via-ink/55 to-ink/10"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/70 via-transparent to-transparent"></div>

  <!-- oversized outline word: a quiet signature -->
  <p aria-hidden="true" class="outline-text pointer-events-none absolute -bottom-[0.3em] right-[-3%] -z-10 select-none font-display text-[clamp(7rem,24vw,21rem)] font-semibold leading-none">TEXAS</p>

  <div class="mx-auto w-full max-w-[84rem] px-6 py-28">
    <div class="max-w-2xl">
      <Reveal client:visible><p class="eyebrow on-dark">Proudly Texan</p></Reveal>
      <Reveal client:visible delay={0.1}>
        <h2 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.5rem)] font-light leading-[1.05] tracking-[-0.02em]">
          Skin care as <span class="font-semibold text-sand">big as Texas.</span>
        </h2>
      </Reveal>
      <Reveal client:visible delay={0.2}>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">Long days in the sun, heat and Gulf Coast humidity put Texas skin to the test. From Pearland to Kingwood, our team helps you protect it, treat it and feel good in it all year.</p>
      </Reveal>
      <Reveal client:visible delay={0.3}>
        <a href={BOOK_URL} class="btn btn-sand mt-9">Schedule a skin check</a>
      </Reveal>
    </div>
  </div>
</section>
