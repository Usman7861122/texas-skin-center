---
import Reveal from '../islands/Reveal';
import CountUp from '../islands/CountUp';

const values = [
  { t: 'Personal', d: 'Every plan starts with listening. We explain your options in plain words, then plan care around your skin and your goals.', icon: 'M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z' },
  { t: 'Precise', d: 'Medical, surgical and cosmetic treatments, from skin checks and Mohs surgery to Botox, fillers and peels, all under one roof.', icon: 'M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z' },
  { t: 'Close to home', d: 'Three clinics in Pearland, Houston and Kingwood, with same-day appointments for patients of every age.', icon: 'M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11zM12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z' },
];
---
<section id="story" class="section bg-aurora grain">
  <div class="orb blue" style="width:26rem;height:26rem;left:-8rem;top:2rem"></div>
  <div class="wrap grid items-center gap-16 lg:grid-cols-[1fr_1.05fr]">
    <Reveal client:visible x={-40} y={0}>
      <div class="plate">
        <div class="sq shadow-[0_40px_70px_-34px_rgba(10,34,57,.6)]">
          <img src="/images/gallery/g2.jpg" alt="Two team members reviewing a patient chart together on a tablet" loading="lazy" />
        </div>
      </div>
    </Reveal>
    <div>
      <Reveal client:visible><p class="eyebrow">Who we are</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">Expert dermatology with a <b>personalized approach</b></h2></Reveal>
      <Reveal client:visible delay={0.16}>
        <div class="mt-7 space-y-4 text-[1.02rem] leading-relaxed text-ink/75">
          <p>Texas Skin Center is a dermatology practice serving Pearland, Houston and Kingwood, Texas. Our board-certified dermatologists and skilled medical team treat patients of all ages, from a child's first rash to a lifelong skin check.</p>
          <p>We offer medical, surgical and cosmetic care, including acne treatment, Mohs surgery, laser skin resurfacing, fillers, Botox and chemical peels. Same-day appointments are available, so you do not have to wait long to be seen.</p>
          <p>Our lead physician, Dr. Joseph Sedrak, has more than 10 years of experience and has treated over 10,000 skin cancers. He is a Fellow of the American Academy of Dermatology and the American College of Mohs Surgeons.</p>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<section class="section bg-ink text-white">
  <div class="orb deep" style="width:30rem;height:30rem;right:-10rem;top:-8rem"></div>
  <div class="wrap">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <Reveal client:visible><p class="eyebrow on-dark justify-center">What we stand for</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 on-dark mt-5">Care that is <b>personal, precise</b> and close</h2></Reveal>
    </div>
    <ul class="grid gap-6 md:grid-cols-3">
      {values.map((v, i) => (
        <li>
          <Reveal client:visible delay={i * 0.1} className="h-full">
            <article class="pcard group h-full !p-7">
              <span class="grid h-12 w-12 place-items-center rounded-[6px] bg-sapphire text-white transition group-hover:bg-sand group-hover:text-ink">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d={v.icon} /></svg>
              </span>
              <h3 class="mt-6 font-display text-[1.3rem] font-medium">{v.t}</h3>
              <p class="mt-3 leading-relaxed text-white/70">{v.d}</p>
            </article>
          </Reveal>
        </li>
      ))}
    </ul>

    <Reveal client:visible>
      <dl class="mt-16 grid grid-cols-2 gap-4 border-t border-white/10 pt-12 md:grid-cols-4">
        {[
          { n: 10, s: '+', l: 'Years of experience' },
          { n: 10000, s: '+', l: 'Skin cancers treated' },
          { n: 3, s: '', l: 'Clinics across greater Houston' },
          { n: 5, s: '', l: 'Providers on our care team' },
        ].map((x) => (
          <div class="text-center">
            <dd class="font-display text-[clamp(2.2rem,4.5vw,3.5rem)] font-light text-sand"><CountUp client:visible to={x.n} suffix={x.s} /></dd>
            <dt class="mt-1 text-sm text-white/65">{x.l}</dt>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-center text-[0.78rem] text-white/45">Experience and cases describe Dr. Sedrak, our lead physician.</p>
    </Reveal>
  </div>
</section>
