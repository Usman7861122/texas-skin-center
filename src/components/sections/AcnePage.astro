---
import PageHero from './PageHero.astro';
import Reveal from '../islands/Reveal';
import { BOOK_URL, PHONE, PHONE_HREF, locations } from '../../data/site';
interface Props { city?: string; nearby?: string; }
const { city, nearby } = Astro.props;

const types = [
  { k: 'comedone', level: 1, lv: 'Mild', t: 'Whiteheads and blackheads', d: 'Clogged pores that stay closed (whiteheads) or open up and darken (blackheads). The mildest form, and often the first sign.' },
  { k: 'papule', level: 2, lv: 'Moderate', t: 'Papules and pustules', d: 'Red, tender bumps, some with a white center. They appear when clogged pores become inflamed.' },
  { k: 'nodule', level: 3, lv: 'Severe', t: 'Nodules and cysts', d: 'Deep, painful lumps under the skin. These can leave scars, so early treatment matters.' },
  { k: 'hormonal', level: 2, lv: 'Varies', t: 'Hormonal acne', d: 'Breakouts along the jaw and chin that flare with the menstrual cycle, stress or life changes, in teens and adults.' },
];
const options = [
  { t: 'Topical treatments', d: 'Prescription creams and gels that unclog pores, calm redness and slow new breakouts.' },
  { t: 'Oral medicines', d: 'For moderate to severe acne, your provider may prescribe pills and monitor you closely while you take them.' },
  { t: 'Hormone-focused care', d: 'When breakouts follow hormone changes, we look at options built around that pattern.' },
  { t: 'In-office procedures', d: 'Treatments such as chemical peels can help with oil, texture and marks left behind.' },
  { t: 'Scar and mark care', d: 'Once acne is under control, we discuss ways to smooth texture and fade dark spots.' },
];
const steps = [
  { t: 'Skin exam', d: 'We look at your skin, ask about products, hormones, stress and past treatments.' },
  { t: 'Clear plan', d: 'You get a written plan in plain words, with what to use, when, and what to expect.' },
  { t: 'Start treatment', d: 'Most plans begin with a prescription routine. Some visits include an in-office treatment.' },
  { t: 'Follow-up', d: 'We check your progress and adjust. Acne care takes time, and we stay with you.' },
];
const faqs = [
  { q: 'How long does acne treatment take to work?', a: 'Most treatments need several weeks before you see a clear change, and full results often take a few months. Your provider will tell you what to expect for your plan.' },
  { q: 'Can adults get acne too?', a: 'Yes. Many adults get acne, often along the jaw and chin. We treat acne in teens and adults.' },
  { q: 'Will acne leave scars?', a: 'Deep or inflamed acne is more likely to scar. Starting treatment early lowers the risk, and we also offer care for marks and scars.' },
  { q: 'Do I need to stop other skin products?', a: 'Bring your products to the visit. Some can irritate acne-prone skin or interact with prescription treatments, and we will tell you what to keep.' },
  { q: 'Can my child be seen for acne?', a: 'Yes. Our team treats patients of all ages, including pre-teens and teens.' },
  { q: 'Do you take insurance?', a: 'We accept many insurance plans. Call us at 346-888-4400 and we will check your plan.' },
];
const others = city ? locations.filter((l) => l.city !== city) : locations;
const hero = city
  ? { title: 'Acne Treatment', accent: `in ${city}.` }
  : { title: 'Acne care that', accent: 'clears the way.' };
const overviewTitle = city ? `Acne treatment in ${city}, planned around your skin` : 'Acne care planned around your skin';
const ctaTitle = city ? `Book your acne visit in ${city}` : 'Ready for clearer skin?';
---
<PageHero
  eyebrow="Acne"
  title={hero.title}
  accent={hero.accent}
  lead="Expert dermatology care for teens and adults, with clear plans and same-day appointments."
  image="/images/acne/exam.jpg"
  alt="A dermatologist carefully examining a patient's face under a magnifying lamp"
  pos="50% 35%"
  nearby={nearby}
  ctaLabel="What we treat"
  ctaHref="#types"
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Acne' }]}
/>

<section class="section bg-aurora grain">
  <div class="orb blue" style="width:26rem;height:26rem;left:-8rem;top:2rem"></div>
  <div class="wrap grid items-center gap-16 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <Reveal client:visible><p class="eyebrow">Overview</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">{overviewTitle}</h2></Reveal>
      <Reveal client:visible delay={0.16}>
        <div class="mt-7 space-y-4 text-[1.02rem] leading-relaxed text-ink/75">
          <p>Acne is one of the most common skin conditions. It starts when pores fill with oil and dead skin cells, and bacteria and inflammation can turn those clogged pores into red bumps, deep lumps and marks.</p>
          <p>Over-the-counter products help some people, but acne that is painful, spreading or leaving marks needs a plan from a dermatologist. Treating it early protects your skin and your confidence.</p>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3">
          {['Teens and adults', 'Same-day appointments', 'Medical and cosmetic options'].map((t) => (
            <li class="rounded-[6px] border border-ink/10 bg-white/80 px-4 py-2 font-display text-[0.78rem] uppercase tracking-[0.12em] text-ink shadow-[0_10px_24px_-16px_rgba(10,34,57,.5)]">{t}</li>
          ))}
        </ul>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href={BOOK_URL} class="btn btn-primary">Book Appointment</a>
          <a href={PHONE_HREF} class="btn btn-dark-ghost">Call {PHONE}</a>
        </div>
      </Reveal>
    </div>
    <Reveal client:visible x={40} y={0}>
      <div class="plate">
        <div class="sq shadow-[0_40px_70px_-34px_rgba(10,34,57,.6)]">
          <img src="/images/acne/closeup.jpg" alt="A dermatologist using a magnifying glass to look closely at acne on a man's cheek" loading="lazy" style="object-position:55% 40%" />
        </div>
      </div>
    </Reveal>
  </div>
</section>

<section id="types" class="section bg-sand grain">
  <div class="wrap">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <Reveal client:visible><p class="eyebrow justify-center">Types of acne</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">Not all breakouts are <b>the same</b></h2></Reveal>
    </div>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {types.map((x, i) => (
        <li>
          <Reveal client:visible delay={i * 0.08} className="h-full">
            <article class="group flex h-full flex-col overflow-hidden rounded-[10px] bg-white shadow-[0_28px_56px_-30px_rgba(10,34,57,.6)] transition duration-500 hover:-translate-y-2 hover:shadow-[0_40px_70px_-30px_rgba(27,111,184,.55)]">
              <div class="relative bg-gradient-to-b from-ice to-white px-6 pt-6">
                <svg viewBox="0 0 160 84" class="w-full transition duration-500 group-hover:scale-[1.04]" role="img" aria-label={`Cross-section of skin showing ${x.t.toLowerCase()}`}>
                  <path d="M0 44 Q40 40 80 44 T160 44 V84 H0Z" fill="#f4d9c6" />
                  <path d="M0 62 Q40 58 80 62 T160 62 V84 H0Z" fill="#e9c1a6" />
                  <path d="M0 44 Q40 40 80 44 T160 44" fill="none" stroke="#d9a98a" stroke-width="1.5" />
                  {x.k === 'comedone' && (<g>
                    <ellipse cx="58" cy="41" rx="9" ry="6" fill="#fff" stroke="#ecd9c8" />
                    <ellipse cx="108" cy="43" rx="6" ry="4" fill="#262b36" />
                    <path d="M100 47v10M116 47v10" stroke="#d9a98a" stroke-width="1.5" />
                    <path d="M50 46v11M66 46v11" stroke="#d9a98a" stroke-width="1.5" />
                  </g>)}
                  {x.k === 'papule' && (<g>
                    <path d="M54 44 Q80 6 106 44Z" fill="#e0645f" />
                    <circle cx="80" cy="25" r="5" fill="#fff6e6" />
                    <path d="M54 44 Q80 6 106 44" fill="none" stroke="#c94b47" stroke-width="1.5" />
                  </g>)}
                  {x.k === 'nodule' && (<g>
                    <circle cx="80" cy="58" r="26" fill="#e0645f" opacity=".25" />
                    <circle cx="80" cy="58" r="16" fill="#c4474a" />
                    <path d="M64 44 Q80 32 96 44" fill="#e0645f" />
                  </g>)}
                  {x.k === 'hormonal' && (<g>
                    <path d="M30 44 Q40 30 50 44Z" fill="#e0645f" />
                    <path d="M68 44 Q80 24 92 44Z" fill="#e0645f" />
                    <path d="M110 44 Q119 34 128 44Z" fill="#e0645f" />
                    <path d="M138 14a9 9 0 1 0 8 13 7 7 0 0 1-8-13z" fill="#1b6fb8" />
                  </g>)}
                </svg>
              </div>
              <div class="flex flex-1 flex-col p-6 pt-5">
                <h3 class="font-display text-[1.15rem] font-medium leading-snug text-ink">{x.t}</h3>
                <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink/70">{x.d}</p>
                <div class="mt-6 flex items-center gap-3 border-t border-ink/10 pt-4">
                  <span class="flex gap-1" aria-hidden="true">
                    {[1, 2, 3].map((n) => <span class={`h-1.5 w-6 rounded-full ${n <= x.level ? 'bg-sapphire' : 'bg-ink/10'}`}></span>)}
                  </span>
                  <span class="font-display text-[0.78rem] font-medium text-ink/70">{x.lv}</span>
                </div>
              </div>
            </article>
          </Reveal>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section bg-ink text-white">
  <div class="orb deep" style="width:32rem;height:32rem;right:-10rem;top:-8rem"></div>
  <div class="wrap grid items-center gap-16 lg:grid-cols-[1fr_1.1fr]">
    <Reveal client:visible x={-40} y={0}>
      <div class="plate">
        <div class="sq shadow-[0_50px_80px_-40px_rgba(0,0,0,.8)]">
          <img src="/images/acne/mirror.jpg" alt="A young woman checking her skin in a hand mirror during a dermatology visit" loading="lazy" style="object-position:35% 40%" />
        </div>
      </div>
    </Reveal>
    <div>
      <Reveal client:visible><p class="eyebrow on-dark">Treatment options</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 on-dark mt-5">Care that <b>fits your skin</b></h2></Reveal>
      <ul class="mt-8 space-y-3">
        {options.map((o, i) => (
          <li>
            <Reveal client:visible delay={i * 0.06}>
              <div class="group flex gap-4 rounded-[8px] border border-white/10 bg-white/[0.05] p-4 transition duration-300 hover:-translate-y-0.5 hover:border-sand/50 hover:bg-white/10">
                <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-[6px] bg-sapphire font-display text-sm">{i + 1}</span>
                <div>
                  <h3 class="font-display text-[1.02rem] font-medium">{o.t}</h3>
                  <p class="mt-1 text-[0.92rem] leading-relaxed text-white/70">{o.d}</p>
                </div>
              </div>
            </Reveal>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-[0.8rem] text-white/50">Your provider chooses treatments after an exam. This page is general information, not medical advice.</p>
    </div>
  </div>
</section>

<section class="section bg-aurora grain">
  <div class="wrap">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <Reveal client:visible><p class="eyebrow justify-center">Your visit</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">What to expect, <b>step by step</b></h2></Reveal>
    </div>
    <ol class="grid gap-6 md:grid-cols-4">
      {steps.map((s, i) => (
        <li>
          <Reveal client:visible delay={i * 0.1} className="h-full">
            <div class="lift relative h-full rounded-[8px] bg-white/85 p-6 shadow-[0_24px_50px_-30px_rgba(10,34,57,.55)]">
              <span class="font-display text-[2.4rem] font-light leading-none text-sapphire/30">{i + 1}</span>
              <h3 class="mt-3 font-display text-[1.1rem] font-medium">{s.t}</h3>
              <p class="mt-2 text-[0.93rem] leading-relaxed text-ink/70">{s.d}</p>
            </div>
          </Reveal>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section bg-sand grain">
  <div class="wrap grid items-start gap-14 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <Reveal client:visible><p class="eyebrow">Teens and adults</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">Acne care for <b>every age</b></h2></Reveal>
      <Reveal client:visible delay={0.16}>
        <p class="mt-6 text-[1.02rem] leading-relaxed text-ink/75">Acne does not stop at the teen years. Our team treats pre-teens, teens and adults, and plans care around school, work, makeup and daily life.</p>
      </Reveal>
      <Reveal client:visible delay={0.24}>
        <div class="plate mt-8 max-w-md">
          <div class="sq shadow-[0_30px_60px_-34px_rgba(10,34,57,.6)]">
            <img src="/images/acne/teen.jpg" alt="Close-up profile of a teenager's face showing acne" loading="lazy" style="object-position:60% 40%" />
          </div>
        </div>
      </Reveal>
    </div>
    <div>
      <Reveal client:visible><p class="eyebrow">Questions</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">Acne treatment <b>FAQ</b></h2></Reveal>
      <div class="mt-8 space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-[8px] bg-white p-5 shadow-[0_18px_40px_-28px_rgba(10,34,57,.55)] open:shadow-[0_24px_50px_-26px_rgba(27,111,184,.5)]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[1rem] font-medium text-ink">
              {f.q}
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-ice text-sapphire transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 leading-relaxed text-ink/70">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section bg-ink text-white">
    <div class="orb deep" style="width:30rem;height:30rem;left:-10rem;top:-6rem"></div>
    <div class="wrap">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <Reveal client:visible><p class="eyebrow on-dark justify-center">{city ? 'Our other clinics' : 'Where we offer it'}</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="h2 on-dark mt-5">{city ? <>Acne care at our <b>other clinics</b></> : <>Acne treatment at <b>three clinics</b></>}</h2></Reveal>
        <Reveal client:visible delay={0.16}><p class="mt-5 text-white/70">{city ? 'Closer to another part of town? Every clinic offers the same expert acne care.' : 'Choose the clinic closest to you. Every location offers the same expert acne care.'}</p></Reveal>
      </div>
      <ul class={`mx-auto grid gap-6 ${city ? 'max-w-4xl md:grid-cols-2' : 'md:grid-cols-3'}`}>
        {others.map((l, i) => (
          <li>
            <Reveal client:visible delay={i * 0.1} className="h-full">
              <article class="pcard group h-full">
                <a href={`/services/acne-${l.id}`} class="block" aria-label={`Acne care in ${l.city}`}><div class="shot"><div class="sq"><img src={l.img} alt={`Reception area at our ${l.city} clinic`} loading="lazy" /><span class="sheen"></span></div></div></a>
                <div class="flex flex-1 flex-col px-3 pb-3 pt-6">
                  <h3 class="font-display text-[1.3rem] font-medium">{l.city}</h3>
                  <p class="mt-2 text-[0.95rem] leading-relaxed text-white/70">{l.line1}<br />{l.line2}</p>
                  <div class="mt-auto flex flex-wrap gap-3 pt-6">
                    <a href={`/services/acne-${l.id}`} class="btn btn-primary btn-sm">Acne care in {l.city}</a>
                    <a href={BOOK_URL} class="btn btn-ghost btn-sm">Book visit</a>
                  </div>
                </div>
              </article>
            </Reveal>
          </li>
        ))}
      </ul>
    </div>
  </section>

<section class="section bg-aurora grain">
  <div class="orb sand" style="width:24rem;height:24rem;right:-6rem;top:-4rem"></div>
  <div class="wrap">
    <div class="rounded-[10px] bg-gradient-to-br from-navy to-sapphire p-10 text-center text-white shadow-[0_50px_90px_-40px_rgba(27,111,184,.8)] md:p-16">
      <Reveal client:visible><h2 class="font-display text-[clamp(1.9rem,4vw,3rem)] font-light leading-tight">{ctaTitle}</h2></Reveal>
      <Reveal client:visible delay={0.1}><p class="mx-auto mt-4 max-w-xl text-white/80">Same-day appointments are available. Call us or book online and start a plan that works for your skin.</p></Reveal>
      <Reveal client:visible delay={0.2}>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={BOOK_URL} class="btn btn-sand">Book Appointment</a>
          <a href={PHONE_HREF} class="btn btn-ghost">Call {PHONE}</a>
        </div>
      </Reveal>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-center gap-3">
      <span class="font-display text-[0.75rem] uppercase tracking-[0.2em] text-ink/60">Related care</span>
      <a href="/services/chemical-peels" class="btn btn-dark-ghost btn-sm">Chemical peels</a>
      <a href="/services/pediatric-dermatology" class="btn btn-dark-ghost btn-sm">Pediatric dermatology</a>
      <a href="/services" class="btn btn-dark-ghost btn-sm">All services</a>
    </div>
  </div>
</section>
