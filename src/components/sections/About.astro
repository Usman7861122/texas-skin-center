---
import Reveal from '../islands/Reveal';
import CountUp from '../islands/CountUp';
import { media } from '../../data/site';
---
<section id="about" class="section bg-aurora grain">
  <div class="orb blue" style="width:26rem;height:26rem;left:-8rem;top:4rem"></div>
  <div class="orb sand" style="width:22rem;height:22rem;right:-6rem;bottom:2rem;animation-delay:-6s"></div>

  <div class="wrap grid items-center gap-16 lg:grid-cols-[1.05fr_1fr]">
    <!-- image cluster -->
    <Reveal client:visible x={-40} y={0}>
      <div class="group relative mx-auto max-w-[34rem] pb-12 pr-10 lg:mx-0">
        <div class="plate">
          <div class="sq shadow-[0_40px_70px_-34px_rgba(10,34,57,.6)]">
            <img src={media.aboutMain} alt="The Texas Skin Center team standing together in the clinic" loading="lazy" class="group-hover:scale-105" />
          </div>
        </div>
        <div class="absolute bottom-0 right-0 w-[44%] rounded-[6px] border-[6px] border-white shadow-[0_30px_50px_-24px_rgba(10,34,57,.7)] transition-transform duration-700 [animation:float_7s_ease-in-out_infinite] group-hover:-translate-y-3 group-hover:translate-x-2">
          <div class="sq !rounded-[2px]">
            <img src={media.aboutSmall} alt="Care team members reviewing a tablet together" loading="lazy" />
          </div>
        </div>
      </div>
    </Reveal>

    <!-- copy -->
    <div>
      <Reveal client:visible><p class="eyebrow">About Texas Skin Center</p></Reveal>
      <Reveal client:visible delay={0.08}>
        <h2 class="h2 mt-5">Dermatology that is <b>personal</b>, precise and close to home</h2>
      </Reveal>
      <Reveal client:visible delay={0.16}>
        <div class="mt-7 space-y-4 text-[1.02rem] leading-relaxed text-ink/75">
          <p>Texas Skin Center provides expert dermatologic care with a personalized approach. Our board-certified dermatologists and skilled medical team offer medical, surgical and cosmetic skin treatments for patients of all ages in Pearland, Houston and Kingwood.</p>
          <p>We combine advanced technology, proven treatments and compassionate care. Your skin health is our priority, today and for years to come.</p>
        </div>
      </Reveal>

      <Reveal client:visible delay={0.24}>
        <dl class="mt-10 grid grid-cols-3 gap-4">
          <div class="stat group/stat relative overflow-hidden rounded-[6px] bg-white/80 p-5 shadow-[0_18px_40px_-26px_rgba(10,34,57,.6)] transition duration-500 hover:-translate-y-2 hover:bg-white hover:shadow-[0_30px_50px_-24px_rgba(27,111,184,.6)]">
            <dt class="order-2 mt-1 text-[0.78rem] leading-snug text-ink/60">Years of experience</dt>
            <dd class="font-display text-3xl font-semibold text-sapphire"><CountUp client:visible to={10} suffix="+" /></dd>
            <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-sapphire transition-transform duration-700 group-hover/stat:scale-x-100"></span>
          </div>
          <div class="stat group/stat relative overflow-hidden rounded-[6px] bg-white/80 p-5 shadow-[0_18px_40px_-26px_rgba(10,34,57,.6)] transition duration-500 hover:-translate-y-2 hover:bg-white hover:shadow-[0_30px_50px_-24px_rgba(27,111,184,.6)]">
            <dt class="mt-1 text-[0.78rem] leading-snug text-ink/60">Skin cancers treated</dt>
            <dd class="font-display text-3xl font-semibold text-sapphire"><CountUp client:visible to={10000} suffix="+" /></dd>
            <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-sapphire transition-transform duration-700 group-hover/stat:scale-x-100"></span>
          </div>
          <div class="stat group/stat relative overflow-hidden rounded-[6px] bg-white/80 p-5 shadow-[0_18px_40px_-26px_rgba(10,34,57,.6)] transition duration-500 hover:-translate-y-2 hover:bg-white hover:shadow-[0_30px_50px_-24px_rgba(27,111,184,.6)]">
            <dt class="mt-1 text-[0.78rem] leading-snug text-ink/60">Clinics across greater Houston</dt>
            <dd class="font-display text-3xl font-semibold text-sapphire"><CountUp client:visible to={3} /></dd>
            <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-sapphire transition-transform duration-700 group-hover/stat:scale-x-100"></span>
          </div>
        </dl>
        <p class="mt-3 text-[0.78rem] text-ink/50">Figures describe Dr. Sedrak, our lead physician, a Fellow of the American Academy of Dermatology and the American College of Mohs Surgeons.</p>
      </Reveal>

      <Reveal client:visible delay={0.3}>
        <a href="/providers/joseph-sedrak-md" class="btn btn-primary mt-9">Meet Dr. Sedrak
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </Reveal>
    </div>
  </div>
</section>

<style is:global>
  @keyframes float { 0%,100% { translate: 0 0; } 50% { translate: 0 -12px; } }
</style>
