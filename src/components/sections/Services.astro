---
import Reveal from '../islands/Reveal';
import { services } from '../../data/site';
---
<section id="services" class="section bg-sand grain">
  <div class="orb deep" style="width:30rem;height:30rem;right:-10rem;top:-8rem"></div>
  <div class="orb blue" style="width:22rem;height:22rem;left:-6rem;bottom:-4rem;animation-delay:-8s"></div>

  <div class="wrap">
    <div class="mx-auto max-w-2xl text-center">
      <Reveal client:visible><p class="eyebrow">Services we offer</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">Everything your skin needs, <b>under one roof</b></h2></Reveal>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {services.map((s, i) => (
        <Reveal client:visible delay={(i % 3) * 0.1}>
          <a href={s.href} class="service lift group block rounded-[6px]" aria-label={`${s.title}: ${s.desc}`}>
            <div class="sq">
              <img src={s.img} alt="" loading="lazy" referrerpolicy="no-referrer" />
              <div class="veil"></div>
              <span class="go" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 17L17 7M9 7h8v8"/></svg>
              </span>
              <div class="copy">
                <h3 class="font-display text-[1.35rem] font-medium leading-tight">{s.title}</h3>
                <p class="desc mt-2 text-[0.95rem] leading-snug text-white/85">{s.desc}</p>
              </div>
            </div>
          </a>
        </Reveal>
      ))}
    </div>

    <Reveal client:visible delay={0.1}>
      <div class="mt-14 text-center">
        <a href="/services" class="btn btn-primary">View more services
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <p class="mt-4 text-sm text-ink/60">Also: IPL treatment, actinic keratosis care, hair loss (PRP) and more.</p>
      </div>
    </Reveal>
  </div>
</section>
