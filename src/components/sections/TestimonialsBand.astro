---
import Reveal from '../islands/Reveal';
import Testimonials from '../islands/Testimonials';
import { testimonials, media } from '../../data/site';
---
<section id="testimonials" class="relative overflow-hidden bg-ink">
  <div class="orb deep" style="width:30rem;height:30rem;right:-10rem;top:-8rem"></div>

  <!-- heading sits above the photo so nobody's face is covered -->
  <div class="relative z-10 mx-auto max-w-[84rem] px-6 pb-12 pt-24 text-white">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <Reveal client:visible><p class="eyebrow on-dark">Words from our patients</p></Reveal>
        <Reveal client:visible delay={0.1}>
          <h2 class="h2 on-dark mt-5">Care you can feel, from <b>a team that knows your name</b></h2>
        </Reveal>
      </div>
    </div>
  </div>

  <!-- big team photo: faces fully visible, quote card overlaps only the lower edge -->
  <div class="relative h-[80vh] min-h-[32rem] w-full overflow-hidden">
    <img src={media.group} alt="The Texas Skin Center team gathered together in the clinic" class="absolute inset-0 h-full w-full object-cover object-[50%_22%]" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent via-45% to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto -mt-36 max-w-4xl px-6 pb-20 md:-mt-44 md:pb-28">
    <Reveal client:visible><Testimonials client:visible items={testimonials} /></Reveal>
  </div>
</section>
