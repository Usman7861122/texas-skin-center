---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Reveal from '../../components/islands/Reveal';
import { posts, BOOK_URL, PHONE, PHONE_HREF } from '../../data/site';
const [featured, ...rest] = posts;
---
<BaseLayout title="Skin Care Articles | Texas Skin Center Blog" description="Skin advice from the dermatologists at Texas Skin Center in Pearland, Houston and Kingwood, TX. Read tips on acne, fillers, insurance, appointments and more.">
  <PageHero
    eyebrow="Our blog"
    title="Skin advice from"
    accent="our dermatologists."
    lead="Plain-language articles on skin health, treatments and what to expect at your visit."
    image="/images/DSC05723-1-scaled-e1761843955868.jpg"
    alt="Two members of the Texas Skin Center team talking in the clinic hallway"
    pos="50% 35%"
    ctaLabel="Read articles"
    ctaHref="#articles"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
  />

  <section id="articles" class="section bg-aurora grain">
    <div class="orb sand" style="width:26rem;height:26rem;left:-8rem;top:-4rem"></div>
    <div class="wrap">
      <Reveal client:visible>
        <a href={featured.href} class="group grid items-center gap-10 rounded-[10px] bg-white p-5 shadow-[0_40px_80px_-40px_rgba(10,34,57,.55)] transition duration-500 hover:-translate-y-1 md:grid-cols-[1.1fr_1fr] md:p-8">
          <div class="plate">
            <div class="sq shadow-[0_30px_50px_-30px_rgba(10,34,57,.6)]">
              <img src={featured.img} alt="" loading="lazy" referrerpolicy="no-referrer" class="group-hover:scale-105" />
              <span class="absolute left-3 top-3 rounded-[4px] bg-white/90 px-3 py-1 font-display text-[0.7rem] font-medium uppercase tracking-[0.14em] text-ink">Latest</span>
            </div>
          </div>
          <div>
            <p class="eyebrow">{featured.date}</p>
            <h2 class="mt-4 font-display text-[clamp(1.6rem,3vw,2.3rem)] font-light leading-tight transition-colors group-hover:text-sapphire">{featured.title}</h2>
            <span class="btn btn-primary mt-8">Read article</span>
          </div>
        </a>
      </Reveal>

      <div class="mt-14 grid gap-8 md:grid-cols-2">
        {rest.map((p, i) => (
          <Reveal client:visible delay={i * 0.1}>
            <a href={p.href} class="group block">
              <div class="plate">
                <div class="sq shadow-[0_30px_50px_-30px_rgba(10,34,57,.6)]">
                  <img src={p.img} alt="" loading="lazy" referrerpolicy="no-referrer" class="group-hover:scale-110" />
                  <span class="absolute left-3 top-3 rounded-[4px] bg-white/90 px-3 py-1 font-display text-[0.7rem] font-medium uppercase tracking-[0.14em] text-ink">{p.date}</span>
                </div>
              </div>
              <h3 class="mt-9 font-display text-[1.3rem] font-medium leading-snug transition-colors group-hover:text-sapphire">{p.title}</h3>
              <span class="btn btn-dark-ghost btn-sm mt-5 group-hover:bg-ink group-hover:text-white">Read article</span>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="orb deep" style="width:30rem;height:30rem;left:-10rem;top:-6rem"></div>
    <div class="wrap">
      <div class="rounded-[10px] bg-gradient-to-br from-navy to-sapphire p-10 text-center shadow-[0_50px_90px_-40px_rgba(27,111,184,.8)] md:p-16">
        <Reveal client:visible><h2 class="font-display text-[clamp(1.9rem,4vw,3rem)] font-light leading-tight">Have a question about your skin?</h2></Reveal>
        <Reveal client:visible delay={0.1}><p class="mx-auto mt-4 max-w-xl text-white/80">Articles help, but nothing replaces an exam. Book a visit with one of our providers.</p></Reveal>
        <Reveal client:visible delay={0.2}>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href={BOOK_URL} class="btn btn-sand">Book Appointment</a>
            <a href={PHONE_HREF} class="btn btn-ghost">Call {PHONE}</a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>
