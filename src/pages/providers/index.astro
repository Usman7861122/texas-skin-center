---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Locations from '../../components/sections/Locations.astro';
import Reveal from '../../components/islands/Reveal';
import { providers, media, BOOK_URL, PHONE, PHONE_HREF } from '../../data/site';
const lead = providers[0];
const team = providers.slice(1);
---
<BaseLayout title="Our Providers | Texas Skin Center" description="Meet the dermatologists, physician assistant and nurse practitioner at Texas Skin Center in Pearland, Houston and Kingwood, TX.">
  <PageHero
    eyebrow="Our providers"
    title="Meet the people who"
    accent="care for your skin."
    lead="Board-certified dermatologists, a physician assistant and a nurse practitioner, working together across three Texas clinics."
    image={media.group}
    alt="The Texas Skin Center care team standing together in the clinic"
    pos="50% 30%"
    ctaLabel="Meet the team"
    ctaHref="#lead"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Providers' }]}
  />

  <section id="lead" class="section bg-aurora grain">
    <div class="orb blue" style="width:26rem;height:26rem;left:-8rem;top:2rem"></div>
    <div class="wrap grid items-center gap-16 lg:grid-cols-[0.9fr_1.1fr]">
      <Reveal client:visible x={-40} y={0}>
        <a href={lead.href} class="plate block" aria-label={`View profile: ${lead.name}`}>
          <div class="sq shadow-[0_40px_70px_-34px_rgba(10,34,57,.6)]">
            <img src="/images/providers/sedrak-1.jpg" alt={`Portrait of ${lead.name}`} loading="lazy" style="object-position:50% 22%" />
          </div>
        </a>
      </Reveal>
      <div>
        <Reveal client:visible><p class="eyebrow">Lead physician</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="h2 mt-5">{lead.name}</h2></Reveal>
        <Reveal client:visible delay={0.16}>
          <p class="mt-3 font-display text-[1.05rem] text-sapphire">{lead.role}</p>
          <p class="mt-6 max-w-xl text-[1.02rem] leading-relaxed text-ink/75">{lead.note} He leads our team with a focus on clear answers, careful treatment and skin cancer care.</p>
          <ul class="mt-6 flex flex-wrap gap-3">
            {lead.badges.map((b) => (
              <li class="rounded-[6px] border border-ink/10 bg-white/80 px-4 py-2 font-display text-[0.78rem] uppercase tracking-[0.12em] text-ink shadow-[0_10px_24px_-16px_rgba(10,34,57,.5)]">{b}</li>
            ))}
          </ul>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href={lead.href} class="btn btn-primary">View profile</a>
            <a href={BOOK_URL} class="btn btn-dark-ghost">Book Appointment</a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="orb deep" style="width:34rem;height:34rem;right:-12rem;top:-10rem"></div>
    <div class="orb sand" style="width:20rem;height:20rem;left:-6rem;bottom:-5rem;opacity:.18;animation-delay:-5s"></div>
    <div class="wrap">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <Reveal client:visible><p class="eyebrow on-dark justify-center">Our care team</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="h2 on-dark mt-5">Experts you can <b>talk to</b></h2></Reveal>
      </div>
      <ul class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2">
        {team.map((p, i) => (
          <li class="flex">
            <Reveal client:visible delay={i * 0.1} className="flex w-full">
              <article class="pcard group md:flex-row md:items-stretch md:gap-3">
                <a href={p.href} class="block md:w-[44%] md:shrink-0" aria-label={`View profile: ${p.name}`}>
                  <div class="shot">
                    <div class="sq">
                      <img src={p.img} alt={`Portrait of ${p.name}`} loading="lazy" style={`object-position:${p.pos}`} />
                      <span class="sheen"></span>
                      <div class="absolute inset-x-0 bottom-0 z-[1] h-2/5 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"></div>
                    </div>
                  </div>
                </a>
                <div class="flex flex-1 flex-col px-3 pb-3 pt-4 md:pt-5">
                  <h3 class="font-display text-[1.25rem] font-medium leading-snug text-white">{p.name}</h3>
                  <p class="mt-1.5 text-[0.9rem] leading-snug text-sand md:min-h-[3.4rem]">{p.role}</p>
                  <div class="my-4 h-px w-12 bg-gradient-to-r from-sand to-transparent transition-all duration-700 group-hover:w-full"></div>
                  <p class="text-[0.93rem] leading-relaxed text-white/70">{p.note}</p>
                  <div class="mt-auto flex flex-wrap gap-3 pt-7">
                    <a href={p.href} class="btn btn-primary btn-sm">View profile</a>
                    <a href={BOOK_URL} class="btn btn-ghost btn-sm">Book visit</a>
                  </div>
                </div>
              </article>
            </Reveal>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-sand grain">
    <div class="orb deep" style="width:28rem;height:28rem;right:-10rem;top:-6rem"></div>
    <div class="wrap">
      <div class="rounded-[10px] bg-gradient-to-br from-navy to-sapphire p-10 text-center text-white shadow-[0_50px_90px_-40px_rgba(27,111,184,.8)] md:p-16">
        <Reveal client:visible><h2 class="font-display text-[clamp(1.9rem,4vw,3rem)] font-light leading-tight">Not sure who to see?</h2></Reveal>
        <Reveal client:visible delay={0.1}><p class="mx-auto mt-4 max-w-xl text-white/80">Tell us what is going on with your skin. Our team will help you book with the right provider, often the same day.</p></Reveal>
        <Reveal client:visible delay={0.2}>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href={BOOK_URL} class="btn btn-sand">Book Appointment</a>
            <a href={PHONE_HREF} class="btn btn-ghost">Call {PHONE}</a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <Locations />
</BaseLayout>
