---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Texas Skin Center">
  <section class="section bg-aurora grain min-h-[70vh] pt-44 text-center">
    <div class="wrap">
      <p class="eyebrow justify-center">404</p>
      <h1 class="h2 mt-5">This page <b>isn't here</b></h1>
      <p class="mx-auto mt-5 max-w-md text-ink/70">The link may be old or mistyped. Head back to the homepage or call us at 346-888-4400.</p>
      <a href="/" class="btn btn-primary mt-8">Back to homepage</a>
    </div>
  </section>
</BaseLayout>
