---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Reveal from '../components/islands/Reveal';
import ContactForm from '../components/islands/ContactForm';
import OpenBadge from '../components/islands/OpenBadge';
import { locations, clinicHours, CLINIC_TZ, PHONE, PHONE_HREF, BOOK_URL, PAY_URL, media } from '../data/site';
const maps = (l: typeof locations[number]) => `https://www.google.com/maps?q=${encodeURIComponent(l.line1 + ', ' + l.line2)}&output=embed`;
const dir = (l: typeof locations[number]) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(l.line1 + ', ' + l.line2)}`;
---
<BaseLayout title="Contact Us | Texas Skin Center" description="Call, book online or send a message to Texas Skin Center. Three clinics in Pearland, Houston and Kingwood, TX with same-day appointments.">
  <PageHero
    eyebrow="Contact us"
    title="We are here to"
    accent="help you."
    lead="Call, book online or send us a message. Same-day appointments are available at all three clinics."
    image="/images/Reception-scaled-e1761820773898.jpg"
    alt="The bright reception area at Texas Skin Center"
    pos="50% 50%"
    ctaLabel={`Call ${PHONE}`}
    ctaHref={PHONE_HREF}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact us' }]}
  />

  <section class="section bg-aurora grain">
    <div class="orb sand" style="width:26rem;height:26rem;right:-8rem;top:-4rem"></div>
    <div class="wrap grid items-start gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <div>
        <Reveal client:visible><p class="eyebrow">Reach us</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="h2 mt-4">Pick the way that <b>suits you.</b></h2></Reveal>
        <ul class="mt-9 space-y-4">
          {[
            { href: PHONE_HREF, label: 'Call us', value: PHONE, icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z' },
            { href: BOOK_URL, label: 'Book online', value: 'Book appointment', icon: 'M3 10h18M8 3v4M16 3v4M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z' },
            { href: PAY_URL, label: 'Pay your bill', value: 'Pay online', icon: 'M3 7h18v10H3zM3 11h18M7 15h3' },
          ].map((c, i) => (
            <li>
              <Reveal client:visible delay={0.1 + i * 0.08}>
                <a href={c.href} class="group flex items-center gap-4 rounded-[8px] bg-white p-5 shadow-[0_24px_48px_-28px_rgba(10,34,57,.5)] transition duration-500 hover:-translate-y-1">
                  <span class="grid h-12 w-12 place-items-center rounded-[6px] bg-sapphire text-white"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
                  <span><span class="block text-sm text-ink/55">{c.label}</span><span class="font-display text-xl">{c.value}</span></span>
                </a>
              </Reveal>
            </li>
          ))}
        </ul>
        <p class="mt-8 max-w-md text-sm leading-relaxed text-ink/60">Please do not send urgent or private medical details by form. For anything urgent, call us. In an emergency, call 911.</p>
      </div>
      <Reveal client:visible delay={0.15} x={40} y={0}><ContactForm client:visible /></Reveal>
    </div>
  </section>

  <section class="section bg-sand grain">
    <div class="wrap">
      <Reveal client:visible><p class="eyebrow">Our clinics</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="h2 mt-4">Find the clinic <b>nearest you.</b></h2></Reveal>
      <div class="mt-12 flex flex-col gap-8">
        {locations.map((l, i) => (
          <Reveal client:visible delay={0.05}>
            <article class="grid overflow-hidden rounded-[10px] bg-white shadow-[0_40px_80px_-40px_rgba(10,34,57,.55)] md:grid-cols-[1fr_1.2fr]">
              <div class="p-8 md:p-10">
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="font-display text-2xl font-medium">{l.city}</h3>
                  <OpenBadge client:load hours={clinicHours} tz={CLINIC_TZ} />
                </div>
                <address class="mt-4 not-italic leading-relaxed text-ink/75">{l.line1}<br />{l.line2}</address>
                <a href={PHONE_HREF} class="mt-3 inline-block font-display text-sapphire">{PHONE}</a>
                <p class="mt-3 text-sm text-ink/55">Mon to Fri, 8:00 AM to 5:00 PM. Closed weekends.</p>
                <div class="mt-7 flex flex-wrap gap-3">
                  <a href={BOOK_URL} class="btn btn-primary btn-sm">Book here</a>
                  <a href={dir(l)} class="btn btn-dark-ghost btn-sm" rel="noopener">Directions</a>
                  <a href={`/locations/${l.id}`} class="btn btn-dark-ghost btn-sm">Clinic page</a>
                </div>
              </div>
              <iframe title={`Map of Texas Skin Center ${l.city}`} src={maps(l)} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-72 w-full border-0 md:h-full md:min-h-[20rem]"></iframe>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
