---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Reveal from '../components/islands/Reveal';
import { testimonials, media, BOOK_URL, PHONE, PHONE_HREF } from '../data/site';
const [featured, ...rest] = testimonials;
const Star = 'M12 2l2.9 6.3 6.9.7-5.1 4.6 1.5 6.8L12 17l-6.2 3.4 1.5-6.8L2.2 9l6.9-.7z';
const Quote = 'M10 8c-3 1-5 3.5-5 7v5h6v-6H8c0-2 1-3 3-3.6L10 8zm9 0c-3 1-5 3.5-5 7v5h6v-6h-3c0-2 1-3 3-3.6L19 8z';
---
<BaseLayout title="Patient Testimonials | Texas Skin Center" description="Read what patients say about Texas Skin Center in Pearland, Houston and Kingwood, TX. Care you can feel, from a team that knows your name.">
  <PageHero
    eyebrow="Testimonials"
    title="Care you can feel,"
    accent="in our patients' words."
    lead="Real words from people who have visited our clinics in Pearland, Houston and Kingwood."
    image={media.group}
    alt="The Texas Skin Center team gathered together in the clinic"
    pos="50% 30%"
    ctaLabel="Read reviews"
    ctaHref="#reviews"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Testimonials' }]}
  />

  <section id="reviews" class="section bg-sand grain">
    <div class="orb blue" style="width:26rem;height:26rem;right:-8rem;top:-4rem"></div>
    <div class="wrap">
      <div class="mb-8 flex flex-wrap items-center gap-3 text-ink">
        <div class="flex gap-1 text-[#f5b301]" aria-hidden="true">{[0,1,2,3,4].map(() => <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d={Star} /></svg>)}</div>
        <p class="font-display text-sm font-medium">Kind words from patients at our 3 clinics</p>
      </div>
      <Reveal client:visible>
        <figure class="relative overflow-hidden rounded-[10px] bg-gradient-to-br from-navy to-sapphire p-10 text-white shadow-[0_50px_90px_-40px_rgba(27,111,184,.8)] md:p-16">
          <svg viewBox="0 0 24 28" class="absolute right-8 top-8 h-24 w-24 text-white/10" fill="currentColor" aria-hidden="true"><path d={Quote} /></svg>
          <div class="relative mb-6 flex gap-1.5 text-[#f5b301]" role="img" aria-label="5 out of 5 stars">{[0,1,2,3,4].map(() => <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true"><path d={Star} /></svg>)}</div>
          <blockquote class="relative max-w-3xl font-display text-[clamp(1.4rem,3vw,2.2rem)] font-light leading-snug">“{featured.quote}”</blockquote>
          <figcaption class="relative mt-8 flex items-center gap-3 font-display text-[0.8rem] uppercase tracking-[0.18em] text-sand">
            <span class="h-px w-10 bg-sand/70"></span>{featured.name}, patient
          </figcaption>
        </figure>
      </Reveal>

      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {rest.map((t, i) => (
          <li>
            <Reveal client:visible delay={i * 0.1} className="h-full">
              <figure class="lift relative flex h-full flex-col rounded-[8px] bg-white p-8 shadow-[0_28px_56px_-30px_rgba(10,34,57,.55)]">
                <svg viewBox="0 0 24 28" class="h-9 w-9 text-sapphire/25" fill="currentColor" aria-hidden="true"><path d={Quote} /></svg>
                <div class="mt-4"><div class="flex gap-1 text-[#f5b301]" role="img" aria-label="5 out of 5 stars">{[0,1,2,3,4].map(() => <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="currentColor" aria-hidden="true"><path d={Star} /></svg>)}</div></div>
                <blockquote class="mt-4 flex-1 leading-relaxed text-ink/80">{t.quote}</blockquote>
                <figcaption class="mt-6 border-t border-ink/10 pt-4 font-display text-[0.8rem] uppercase tracking-[0.16em] text-sapphire">{t.name}</figcaption>
              </figure>
            </Reveal>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center text-[0.78rem] text-ink/50">Testimonials are shared by patients. Individual experiences and results can vary.</p>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="orb deep" style="width:30rem;height:30rem;left:-10rem;top:-6rem"></div>
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <Reveal client:visible><h2 class="font-display text-[clamp(1.9rem,4vw,3rem)] font-light leading-tight">Ready to see why <span class="font-semibold text-sand">patients</span> come back?</h2></Reveal>
        <Reveal client:visible delay={0.1}><p class="mt-5 text-white/75">Same-day appointments are available at all three clinics.</p></Reveal>
        <Reveal client:visible delay={0.2}>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href={BOOK_URL} class="btn btn-sand">Book Appointment</a>
            <a href={PHONE_HREF} class="btn btn-ghost">Call {PHONE}</a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>
