import Providers from '../components/sections/Providers.astro';
import ParallaxBand from '../components/sections/ParallaxBand.astro';
import Insurance from '../components/sections/Insurance.astro';
import TestimonialsBand from '../components/sections/TestimonialsBand.astro';
